# Copia este archivo a .env y rellena los valores reales.
# El .env NUNCA se sube a git.

# Base de datos
POSTGRES_USER=empleo
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=empleo
DATABASE_URL=postgresql://empleo:cambia_esto@postgres:5432/empleo

# Redis
REDIS_URL=redis://redis:6379

# Microservicio de matching (nombre del servicio en la red docker)
MATCHING_URL=http://matching:8000

# Auth
JWT_SECRET=cambia_esto_por_algo_largo
JWT_EXPIRA=7d

# --- Fuentes de ofertas -------------------------------------------------------

# Adzuna (https://developer.adzuna.com). La mejor fuente: trae salario numerico.
# Paises: at au be br ca ch de es fr gb in it mx nl nz pl sg us za
# OJO: Ecuador NO esta soportado (devuelve 404).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble. Emite UNA CLAVE POR PAIS: la de ec.jooble.org es la que trae las
# ofertas LOCALES de Ecuador (pedirla en https://ec.jooble.org/api/about).
# Con la clave de otro pais, ec.jooble.org responde 403.
JOOBLE_API_KEY=
JOOBLE_HOST=ec.jooble.org
JOOBLE_COUNTRY=Ecuador

# ArbeitNow: API publica, no necesita clave. Remotas de Europa, sin salario.
ARBEIT_NOW_URL=https://www.arbeitnow.com/api/job-board-api

# --- Ingesta y ranking --------------------------------------------------------
INGESTA_HORAS=6
MATCHING_EPSILON=0.15

# --- IA generativa (chat, CV, pitch). NO se usa para el matching --------------
# El matching usa embeddings LOCALES (coste $0). OpenRouter solo GENERA TEXTO.
#
# CADENA de modelos, de mas a menos preferido. Los de PAGO van primero y los
# :free cierran como red de seguridad (ver el comentario largo en config/env.js).
#
# El plan :free tiene 20 peticiones/min y 50/dia (1000/dia si se cargaron $10
# alguna vez), y ese tope se comparte: con varias personas probando a la vez se
# roza. Por eso una demo en publico va contra los endpoints de pago.
# Si da 404 "data policy": aceptar la politica de datos en Settings -> Privacy.
#
# La clave NO debe ser la principal de la cuenta: crear una key dedicada con
# Credit limit (openrouter.ai -> Keys -> Create Key). Ver DEPLOY.md.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it,openai/gpt-oss-20b,google/gemma-4-31b-it:free,openai/gpt-oss-20b:free
OPENROUTER_REFERER=https://jobia.duckdns.org
LLM_LIMITE_DIARIO=25

# Secreto para GET /api/health/llm (tokens y coste acumulado del proceso).
# Vacio = el endpoint responde 404. No se expone nada por defecto.
ADMIN_TOKEN=

# --- Fotos de portada (Pexels) ------------------------------------------------
# Clave gratuita en https://www.pexels.com/api/ (200 peticiones/hora).
# Sin clave la app funciona igual: las portadas caen en un respaldo generico.
#
# El backend pide ~30 fotos por tema UNA vez, las cachea 7 dias en Redis y el
# cliente las reparte entre las ofertas. Son ~15 peticiones, no una por oferta.
# La clave NO sale del servidor: el navegador pide las fotos a /api/imagenes.
PEXELS_API_KEY=

# RemoteOK: API publica, sin clave. 100% remoto.
REMOTEOK_URL=https://remoteok.com/api

# Telegram: avisos de ofertas nuevas. Se crea el bot con @BotFather.
# Sin token, el modulo se desactiva solo y el resto de la app sigue igual.
# NO hace falta un chat id: cada usuario vincula el suyo desde su perfil.
TELEGRAM_BOT_TOKEN=

# Afinidad minima para avisar (0-1). Mas alto que el umbral de busqueda (0.52):
# un match mediocre en un carrusel se ignora, pero una notificacion INTERRUMPE.
NOTIF_MIN_SCORE=0.62
# Tope de ofertas por aviso: una lista de 20 no se lee, se cierra.
NOTIF_MAX_POR_TANDA=3

# Careerjet: UNICA fuente con ofertas de ECUADOR. Registro gratuito:
# https://www.careerjet.com/partners/   (sin affid, la fuente se salta)
CAREERJET_AFFID=
